{
  "name": "statement-import-rn",
  "version": "1.0.0",
  "description": "React Native (Expo dev build) client that imports a synthetic bank statement into a local mock API and survives lost responses, relaunches and failed deletes",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "expo": "~58.0.20",
    "expo-asset": "~58.0.18",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.16",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.12",
    "expo-font": "~58.0.10",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "~22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "fast-check": "^4.10.2",
    "globals": "^16.5.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "prettier": "^3.9.10",
    "react-test-renderer": "^19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "~8.3.5",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "verify:kit": "node scripts/verify-kit.mjs",
    "test:kit": "node --test mock-kit/mock-server.test.mjs",
    "test:plugins": "node --test plugins/*.test.js",
    "test:core": "vitest run",
    "test:ui": "jest",
    "test": "npm run verify:kit && npm run test:kit && npm run test:plugins && npm run test:core && npm run test:ui",
    "typecheck": "tsc -p tsconfig.json && tsc -p src && tsc -p src/ui && tsc -p src/adapters && tsc -p src/main && tsc -p tests",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run typecheck && npm run lint && npm test",
    "mock": "npm --prefix mock-kit start",
    "mock:oversize": "npm --prefix mock-kit run fixtures:oversize",
    "fixtures:push": "bash scripts/push-fixtures.sh",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"scripts/*.mjs\" \"plugins/*.js\" \"*.config.{js,mts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"scripts/*.mjs\" \"plugins/*.js\" \"*.config.{js,mts}\"",
    "matrix": "node scripts/matrix.mjs"
  },
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
